# Copie para .env e substitua os valores antes de executar Docker Compose.
# NÃO use essas palavras de exemplo em produção. .env não deve ser versionado.
POSTGRES_DB=facil_municipio
POSTGRES_USER=facil
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL_SEGURA
NEO4J_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_LOCAL_SEGURA

# Para usar a LLM na API local, remova os comentários e preencha os valores.
# A API lê o .env da raiz; variáveis do processo têm prioridade.
# LLM__MODE=azure
# ENDPOINT_AZURE=https://<recurso>.services.ai.azure.com/openai/v1
# LLM_KEY_AZURE=<chave-fornecida-pelo-Azure>
# LLM_AZURE_DEPLOYMENT=gpt-5-mini
